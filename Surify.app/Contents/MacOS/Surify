#!/bin/bash
# Folder that contains Surify.app (the project folder)
DIR="$(cd "$(dirname "$0")/../../.." && pwd)"
PY="$(command -v python3)"
if [ -z "$PY" ]; then
  osascript -e 'display dialog "Python 3 is required to run this app. Install it from python.org and try again." buttons {"OK"} with icon caution'
  exit 1
fi
exec "$PY" "$DIR/Launcher/server.py"
